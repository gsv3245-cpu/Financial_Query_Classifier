# Copy this file to .env
SECRET_KEY=replace-with-a-random-secret
# Local development uses SQLite. Vercel Neon provides NEON_DATABASE_URL; do not commit its value.
DATABASE_URL=sqlite:///fsis.db

# Set MOCK_MODE=true to run the application without an API key.
# Set MOCK_MODE=false after adding your Groq key for the real LLM integration.
MOCK_MODE=true
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
QUERY_MAX_LENGTH=1000
FLASK_DEBUG=true
ADMIN_EMAIL=admin@fsis.local
ADMIN_PASSWORD=change-this-local-password
